# Local-only defaults used by Docker Compose and the demo scripts.
SERVER_PORT=18080
WORKER_MANAGEMENT_PORT=18082
AGENTOPS_ADMIN_TOKEN=local-admin-token
AGENTOPS_DEV_API_KEY=agentops-dev-key
PROVIDER_BASE_URL=http://localhost:18090
PROVIDER_API_KEY=wiremock-key
MYSQL_URL=jdbc:mysql://localhost:13306/agentops?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
MYSQL_USER=agentops
MYSQL_PASSWORD=agentops
REDIS_HOST=localhost
REDIS_PORT=16379
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Optional: enables the full evaluation/release demo against the external FundPilot repository.
FUND_AGENT_HOME=
FUND_AGENT_EVAL_URL=http://localhost:18081/internal/v1/agent/evaluations/execute
FUND_AGENT_EVAL_TOKEN=local-agent-eval-token
