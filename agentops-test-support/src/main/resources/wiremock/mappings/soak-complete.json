{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/chat/completions",
    "bodyPatterns": [{"matchesJsonPath": {"expression": "$.model", "equalTo": "soak-complete"}}]
  },
  "response": {
    "status": 200,
    "headers": {"Content-Type": "text/event-stream"},
    "bodyFileName": "chat-stream.sse",
    "chunkedDribbleDelay": {"numberOfChunks": 20, "totalDuration": 5000}
  }
}
